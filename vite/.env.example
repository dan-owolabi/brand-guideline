# Supabase environment variables
# Copy this file to .env.local and fill in your values (gitignored via *.local)

# ============================================
# APP (used by the Vite client, src/lib/supabase.js)
# ============================================
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Auth redirect override (full URL)
# Example: https://app.guidr.space/auth/callback
VITE_AUTH_REDIRECT_URL=

# ============================================
# ADMIN SCRIPTS (scripts/*.js, server-side only, never used by the client)
# ============================================
# Same project as VITE_SUPABASE_URL above
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Legacy "Nobora" Supabase project referenced by the one-off migration scripts
NOBORA_SUPABASE_URL=https://YOUR_LEGACY_PROJECT_ID.supabase.co
NOBORA_SUPABASE_ANON_KEY=your_legacy_anon_key_here
NOBORA_SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here
