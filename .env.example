# Supabase environment variables
# Copy this file to .env.local and fill in your values

# ============================================
# DEVELOPMENT (New Supabase Project)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key (only for server-side admin operations)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Auth redirect override (full URL)
# Example: https://app.guidr.space/auth/callback
VITE_AUTH_REDIRECT_URL=

# ============================================
# PRODUCTION (Keep for reference)
# ============================================
# PROD_SUPABASE_URL=https://existing_project.supabase.co
# PROD_SUPABASE_ANON_KEY=existing_anon_key
